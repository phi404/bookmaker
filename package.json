{
  "name": "compholio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-test-policy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/harness/*.test.mjs",
    "test:product": "node scripts/build.mjs && node --test tests/product/*.test.mjs",
    "test:e2e": "node scripts/browser-test.mjs --grep @flow",
    "test:compatibility": "node scripts/browser-test.mjs --config=playwright.compatibility.config.mjs",
    "test:visual": "node scripts/browser-test.mjs --grep @visual",
    "test:exports": "node scripts/run-export-check.mjs",
    "verify:harness": "node scripts/verify.mjs --harness-only",
    "verify": "node scripts/verify.mjs",
    "status": "node scripts/status.mjs",
    "serve": "node scripts/serve.mjs",
    "benchmark": "node scripts/build.mjs && node scripts/benchmark-layout.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "fontkit": "2.0.4",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phi404/compholio.git"
  },
  "homepage": "https://phi404.github.io/compholio/"
}
